---
/**
 * Shared footer. Column copy comes from `src/data/site.ts` (captured `shell`).
 * Link targets outside the registry render as plain text — no dead links.
 */
import { brand, contact, footerColumns, footerCopyright, logoPath, withBase } from '@/data/site';
import { pageByPath } from '@/data/pages';
import { mediaPath } from '@/lib/media';

const footerRulePath = mediaPath('https://thebossvietnam.com/assets/images/vien1.png');
const facebookMarkPath = mediaPath('https://thebossvietnam.com/assets/images/fb1.png');
const fanpageThumbPath = mediaPath(
  'https://thebossvietnam.com/thumbs/240x180x2/upload/photo/hinh-anh-dan-den-fanpage-9032.jpg',
);
---

<footer class="site-footer">
  <div class="footer-article">
    <div class="wrap-content footer-grid">
      {
        footerColumns.map((column) => (
          <div class="footer-news">
            {column.kind === 'brand' ? (
              <a class="logo-footer" href={withBase('/')}>
                <img src={withBase(logoPath)} alt={brand.name} width="240" height="90" />
              </a>
            ) : (
              column.kind !== 'facebook' && <p class="footer-title">{column.heading}</p>
            )}

            {column.kind === 'contact' && (
              <div class="footer-info">
                <p>
                  <strong>Địa chỉ: </strong>
                  {contact.address}
                </p>
                <p>
                  <strong>Điện thoại: </strong>
                  <a href={`tel:${contact.phone}`}>{contact.phone}</a>
                </p>
              </div>
            )}

            {column.kind === 'links' && (
              <ul class="footer-ul">
                {column.links.map((link) => (
                  <li>
                    {pageByPath.has(link.path) ? (
                      <a href={withBase(link.path)}>{link.label}</a>
                    ) : (
                      <span>{link.label}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}

            {column.kind === 'facebook' && (
              <div class="footer-facebook">
                <img src={withBase(facebookMarkPath)} alt="logo" width="40" height="180" />
                <a
                  href="https://www.facebook.com/TheBossVietnam"
                  target="_blank"
                  rel="noopener"
                >
                  <img
                    src={withBase(fanpageThumbPath)}
                    alt="THE BOSS VIỆT NAM"
                    width="240"
                    height="180"
                  />
                </a>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
  <div class="footer-powered" style={`--footer-rule:url(${withBase(footerRulePath)})`}>
    <div class="wrap-content">
      <p class="footer-copyright">
        Copyright © {footerCopyright.year} {footerCopyright.holder} - {footerCopyright.licence}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-article {
    background: #fcfcd7;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 240px 300px 200px 280px;
    justify-content: space-between;
    padding: 60px 0;
  }

  .footer-grid > .footer-news:first-child {
    padding: 20px 0 0;
  }

  .footer-title {
    position: relative;
    margin: 0 0 16px;
    padding-bottom: 10px;
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
  }

  .footer-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 39px;
    height: 3px;
    background: var(--background-static);
  }

  .footer-info p {
    margin: 0 0 16px;
  }

  .footer-info a {
    color: inherit;
    text-decoration: none;
  }

  .footer-info a:hover {
    color: var(--color-dark-red);
  }

  .footer-ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-ul li {
    margin-bottom: 5px;
  }

  .footer-ul a,
  .footer-ul span {
    color: var(--color-black);
    text-decoration: none;
  }

  .footer-ul a:hover {
    color: var(--color-dark-red);
  }

  .footer-powered {
    position: relative;
    color: var(--color-static);
    background: var(--background-powered);
    text-align: center;
  }

  .footer-powered::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 55px;
    width: 100%;
    height: 10px;
    background-image: var(--footer-rule);
    background-repeat: repeat;
  }

  .footer-powered .wrap-content {
    padding: 17px 0;
  }

  .footer-copyright {
    margin: 0;
  }

  .logo-footer {
    display: block;
    max-width: 240px;
  }

  .footer-facebook {
    display: flex;
    justify-content: space-between;
  }

  @media (max-width: 991px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      padding: 40px 0;
    }
  }

  @media (max-width: 575px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
