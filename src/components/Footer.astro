---
/**
 * Shared footer. Column copy comes from `src/data/site.ts` (captured `shell`).
 * Link targets outside the registry render as plain text — no dead links.
 */
import { brand, contact, footerColumns, footerCopyright, logoPath, withBase } from '@/data/site';
import { pageByPath } from '@/data/pages';
---

<footer class="site-footer">
  <div class="footer-article">
    <div class="wrap-content footer-grid">
      {
        footerColumns.map((column) => (
          <div class="footer-news">
            {column.kind === 'brand' ? (
              <a class="logo-footer" href={withBase('/')}>
                <img src={withBase(logoPath)} alt={brand.name} width="210" height="79" />
              </a>
            ) : (
              <p class="footer-title">{column.heading}</p>
            )}

            {column.kind === 'contact' && (
              <div class="footer-info">
                <p>
                  <strong>Địa chỉ: </strong>
                  {contact.address}
                </p>
                <p>
                  <strong>Điện thoại: </strong>
                  <a href={`tel:${contact.phone}`}>{contact.phone}</a>
                </p>
              </div>
            )}

            {column.kind === 'links' && (
              <ul class="footer-ul">
                {column.links.map((link) => (
                  <li>
                    {pageByPath.has(link.path) ? (
                      <a href={withBase(link.path)}>{link.label}</a>
                    ) : (
                      <span>{link.label}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </div>
  <div class="footer-powered">
    <div class="wrap-content">
      <p class="footer-copyright">
        Copyright © {footerCopyright.year} {footerCopyright.holder} - {footerCopyright.licence}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    padding: 60px 0;
  }

  .footer-title {
    position: relative;
    margin: 0 0 1rem;
    padding-bottom: 10px;
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .footer-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 39px;
    height: 3px;
    background: var(--background-static);
  }

  .footer-info p {
    margin: 0 0 4px;
  }

  .footer-info a {
    color: inherit;
    text-decoration: none;
  }

  .footer-info a:hover {
    color: var(--color-dark-red);
  }

  .footer-ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-ul li {
    margin-bottom: 5px;
  }

  .footer-ul a,
  .footer-ul span {
    color: var(--color-black);
    text-decoration: none;
  }

  .footer-ul a:hover {
    color: var(--color-dark-red);
  }

  .footer-powered {
    color: var(--color-static);
    background-color: var(--background-powered);
    text-align: center;
  }

  .footer-powered .wrap-content {
    padding: 12px 0;
  }

  .footer-copyright {
    margin: 0;
  }

  .logo-footer {
    display: block;
    max-width: 210px;
  }

  @media (max-width: 991px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      padding: 40px 0;
    }
  }

  @media (max-width: 575px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
